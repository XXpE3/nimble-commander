          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте \"*\" для подстановки нескольких символов, \"?\" для подстановки одного символа и \",\" чтобы указать больше одной маски."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
